NODE_ENV=development
PORT=4600
LOG_LEVEL=info
MONGO_URL=mongodb://127.0.0.1:27017/x360-esign
FRONTEND_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:4600
CONVERTAPI_SECRET=

# Mail is optional. Leave SMTP_HOST or MAIL_FROM empty to disable sending entirely —
# signing links are still returned by the API and shown in the dashboard.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Smart Sign <no-reply@example.com>"
MAIL_REPLY_TO=

# Org authentication. Both must be exactly 16 characters — AES-128-CBC takes nothing else.
# Changing either invalidates every token already issued, and each org has to register again.
ORG_TOKEN_KEY=
ORG_TOKEN_IV=
DEFAULT_PRODUCT_NAME=360 SmartSign
