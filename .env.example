NODE_ENV=development
PORT=4600
LOG_LEVEL=info
MONGO_URL=mongodb://127.0.0.1:27017/x360-esign
FRONTEND_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:4600
CONVERTAPI_SECRET=

# Mail goes through SendGrid. The from address must be a verified sender there. Leave either
# value empty to disable sending: the console still shows signing links, but sends from
# Salesforce are refused.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
MAIL_REPLY_TO=

# Salesforce OAuth. SF_CALLBACK_URI must be listed as a callback URL on the connected app,
# and the same app has to be used by the console flow and the Word add-in's code exchange.
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_LOGIN_URL=https://login.salesforce.com
SF_TEST_LOGIN_URL=https://test.salesforce.com
SF_SERVER_CALLBACK_URI=http://localhost:4600/sf/auth/callback
SF_REDIRECT_URI=http://localhost:3001/oauth/callback

# Signs the app JWT. Changing it signs everyone out; they reconnect on their next request.
JWT_SECRET=

# The File Connector's token encryption, for the routes Salesforce calls. Use the same values
# as the connector, and point MONGO_URL at its database.
NODE_TOKEN_ENCRYPTION_KEY=
NODE_TOKEN_ENCRYPTION_IV=
DEFAULT_APP_NAME=

# Signs status callbacks to Salesforce. At least 32 characters. Print the value an org puts in
# Callback_Secret__c with: npm run callback:secret -- <orgId>
CALLBACK_SIGNING_KEY=
